{
  "expo": {
    "name": "KFIT",
    "slug": "kfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kfit",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobileappbuilder.k14l8o"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0B"
      },
      "package": "com.emergent.mobileappbuilder.k14l8o"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0B"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KFIT utilise votre position, uniquement à votre demande, pour trouver des coachs près de vous ou définir votre zone d'intervention."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
